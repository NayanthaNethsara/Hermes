# Hermes by TheKade - environment template
#
# Copy this file to `.env` in the repository root and fill in the blanks:
#   cp configuration-example/.env.example .env
#
# The backend, the offline workers and Docker Compose all read that single
# root `.env` file. Full reference: docs/configuration.md

# --- Database (PostgreSQL + pgvector) ----------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/archivist

# --- Redis (retrieval cache + rate limiting) ---------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_REQUESTS=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CACHE_TTL_SECONDS=3600

# --- Embeddings and reranking (Voyage AI) ------------------------------------
# Required. Get a key at https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_RERANK_MODEL=rerank-2.5

# --- Language model (Google Gemini) ------------------------------------------
# Either set GCP_PROJECT_ID and authenticate with
# `gcloud auth application-default login`, or set GEMINI_API_KEY.
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# --- Language model fallback (OpenRouter, optional) --------------------------
# Used only when no Gemini credentials are available.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Storage -----------------------------------------------------------------
# Paths are relative to the repository root.
RAW_ARCHIVE_DIR=data/raw_archive
ASSETS_DIR=data/extracted_assets

# --- Retrieval tuning --------------------------------------------------------
RERANK_SCORE_THRESHOLD=0.50
RETRIEVAL_CANDIDATE_LIMIT=50
RERANK_TOP_K=5
MAX_SEARCH_HOPS=5

# --- Source authority weights ------------------------------------------------
WEIGHT_CODEX=1.0
WEIGHT_IMAGE=1.0
WEIGHT_WIKI=0.8
WEIGHT_NOVEL=0.6
WEIGHT_EPHEMERA=0.4
