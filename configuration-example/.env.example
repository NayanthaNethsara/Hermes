# ==============================================================================
# The Archivist - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` at the REPOSITORY ROOT:
#    cp configuration-example/.env.example .env
# 2. Fill in your API keys and configuration values.
# 3. Maintain exactly ONE `.env` file at the repository root.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# Used by SQLAlchemy 2.0 and asyncpg for hybrid vector (HNSW) and keyword search.
# When running with Docker Compose (`make db`), default is:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/archivist

# Redis Configuration (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_REQUESTS=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 2. Voyage AI Configuration (Embeddings & Reranker)
# ------------------------------------------------------------------------------
# Required for multimodal document embeddings and cross-encoder reranking.
# Get an API key at https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_RERANK_MODEL=rerank-2.5

# ------------------------------------------------------------------------------
# 3. Primary LLM: Google Cloud Vertex AI / Gemini 1.5 Pro
# ------------------------------------------------------------------------------
# Used by LangGraph agent nodes for reasoning, arbitration, and synthesis.
# Provide GCP Project ID and Location for Vertex AI:
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-pro

# Alternatively, specify a direct Google AI Studio API key (optional):
# GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Fallback LLM: OpenRouter
# ------------------------------------------------------------------------------
# Used if Vertex AI / Gemini is unavailable or not configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ------------------------------------------------------------------------------
# 5. Local Storage & Asset Directories
# ------------------------------------------------------------------------------
# Paths relative to the repository root.
# RAW_ARCHIVE_DIR: Where the 415 raw documents and images are placed.
# ASSETS_DIR: Where cropped diagrams, tables, and figures are saved and served.
RAW_ARCHIVE_DIR=data/raw_archive
ASSETS_DIR=data/extracted_assets

# ------------------------------------------------------------------------------
# 6. Search & Retrieval Thresholds
# ------------------------------------------------------------------------------
# Score cutoff for cross-encoder reranker (candidates below this are discarded):
RERANK_SCORE_THRESHOLD=0.50

# Maximum candidates fetched during hybrid RRF candidate generation:
RETRIEVAL_CANDIDATE_LIMIT=50

# Number of top verified chunks passed to synthesizer:
RERANK_TOP_K=5

# Maximum search iterations for Track 1C investigator loop:
MAX_SEARCH_HOPS=5

# ------------------------------------------------------------------------------
# 7. Optional Integrations
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (optional):
# TELEGRAM_BOT_TOKEN=
