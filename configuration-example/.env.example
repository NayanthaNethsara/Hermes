# Hermes by TheKade - Environment Template
#
# Copy this file to `.env` in the repository root and fill in the credentials:
#   cp configuration-example/.env.example .env
#
# The FastAPI backend, offline workers, CLI utilities, and Docker Compose
# all read this single root `.env` file. Full reference: docs/configuration.md

# --- Database (PostgreSQL 16 + pgvector) ---------------------------------------
# Connection string for relational storage, vector embeddings, sessions, and LangGraph checkpoints.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/archivist

# --- Redis (Retrieval Cache + Rate Limiting) ----------------------------------
# Optional. The service fails open if Redis is unavailable.
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_REQUESTS=30
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CACHE_TTL_SECONDS=3600

# --- Embeddings & Cross-Encoder Reranking (Voyage AI) -------------------------
# Required for vector search and reranking. Obtain a key at https://dash.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_RERANK_MODEL=rerank-2.5

# --- Primary Language Model (Google Gemini) -----------------------------------
# Option A (Vertex AI): Set GCP_PROJECT_ID and run `gcloud auth application-default login`,
# or provide GOOGLE_APPLICATION_CREDENTIALS pointing to a service account JSON file.
GCP_PROJECT_ID=
GCP_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=

# Option B (Google AI Studio): Provide a direct API key from https://aistudio.google.com/
# GEMINI_API_KEY=

# --- Fallback Language Model Provider (OpenRouter, Optional) ------------------
# Used automatically if direct Google Cloud / Gemini credentials are not configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- Archive Corpus & Extracted Storage Paths ---------------------------------
# Resolved relative to the repository root. Raw archive is treated as strictly read-only.
RAW_ARCHIVE_DIR=data/raw_archive
ASSETS_DIR=data/extracted_assets

# --- Retrieval Tuning & Multi-Hop Search Budget -------------------------------
RERANK_SCORE_THRESHOLD=0.50
RETRIEVAL_CANDIDATE_LIMIT=50
RERANK_TOP_K=5

# Maximum passages provided to the synthesizer across all hops to bound token usage.
SYNTHESIS_CONTEXT_LIMIT=10

# Maximum retrieval iterations per question (main lever controlling model call ceiling).
# 2 hops = up to 5 calls per question; 3 hops = up to 6 calls per question.
MAX_SEARCH_HOPS=2

# --- Epistemic Authority Weights ----------------------------------------------
# Fixed authority hierarchy for conflict arbitration and evidence ordering.
WEIGHT_CODEX=1.0
WEIGHT_IMAGE=1.0
WEIGHT_WIKI=0.8
WEIGHT_NOVEL=0.6
WEIGHT_EPHEMERA=0.4
