# Copy this file to `.env` at the REPO ROOT (not here) and fill in the blanks.
# The frontend has its own separate env file - see src/frontend/.env.local.example

# --- Required: embeddings (ingestion + retrieval) ---------------------------
# Voyage AI key. Get one free at https://dash.voyageai.com/
VOYAGE_API_KEY=

# --- Required: the LLM behind the Planner, Critic, and Synthesizer ----------
# OpenRouter key. Get one free at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Base URL for the OpenRouter-compatible API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must be a free-tier model (id ends in ":free")
OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free

# --- Required only for the Telegram bot -------------------------------------
# Get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- Optional overrides -----------------------------------------------------
# Embedding model. Code default is voyage-4-lite (real, current, free-tier).
# MUST be identical for ingestion and retrieval - if you change it after
# ingesting, re-run ingestion or search results will be meaningless (query
# and chunks would live in different vector spaces).
# NOTE: "voyage-context-4" does NOT exist - it 400s immediately. Voyage's
# real contextualized model is voyage-context-3, served from a *different*
# endpoint (/v1/contextualizedembeddings) with a different payload shape
# than the one below - see docs/decisions.md before switching to it.
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_API_URL=https://api.voyageai.com/v1/embeddings

# Where the Telegram bot and eval harness look for the backend.
# BACKEND_URL=http://localhost:8000

# --- Free-tier budget levers (see SETUP.md "API budget") --------------------
# A worst-case question can cost ~36 OpenRouter requests, against a free tier
# of roughly 50/day. Lower these before a long testing session or a demo.
# Max NEW contradiction comparisons per critic call (default 5).
# CONTRADICTION_MAX_PAIRS=2
# Max search hops per question (default 5). Values above 5 are clamped to 5 -
# the 5-hop ceiling is a hard project rule and cannot be raised from .env.
# MAX_SEARCH_HOPS=3

# --- Rate-limit pacing during ingestion (see SETUP.md "Troubleshooting") ----
# Voyage: confirmed directly from their own 429 error body - an account with
# NO payment method attached is capped at 3 requests/minute and 10K
# tokens/minute. Adding a payment method removes this cap (confirmed
# empirically: ~78 req/min with zero 429s) - the code defaults
# (VOYAGE_EMBED_BATCH_SIZE=32, VOYAGE_REQUEST_INTERVAL_SECONDS=1.5) assume a
# payment method IS attached. The 200M free-token allowance still applies
# either way - adding a card does not forfeit it.
# If you're still on the unverified tier, override to these instead:
# VOYAGE_EMBED_BATCH_SIZE=10
# VOYAGE_REQUEST_INTERVAL_SECONDS=22
#
# OpenRouter has its own separate free-tier limits (see "API budget" above).
# This adds a minimum delay between build_graph.py's per-chunk LLM calls.
# OPENROUTER_REQUEST_INTERVAL_SECONDS=2
